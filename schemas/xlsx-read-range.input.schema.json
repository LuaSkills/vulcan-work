{
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "description": "Absolute path to the local input file."
    },
    "sheet": {
      "type": "string",
      "minLength": 1,
      "description": "Exact worksheet name."
    },
    "range": {
      "type": "string",
      "pattern": "^\\$?[A-Za-z]{1,3}\\$?[1-9][0-9]{0,6}(?::\\$?[A-Za-z]{1,3}\\$?[1-9][0-9]{0,6})?$",
      "description": "One cell or a rectangular A1 range in that worksheet."
    }
  },
  "required": [
    "path",
    "sheet",
    "range"
  ],
  "additionalProperties": false
}
