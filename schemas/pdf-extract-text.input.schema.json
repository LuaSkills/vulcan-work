{
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "description": "Absolute path to the local input file."
    },
    "start_page": {
      "type": "integer",
      "minimum": 1,
      "description": "First page to extract (one-based)."
    },
    "end_page": {
      "type": "integer",
      "minimum": 1,
      "description": "Last page to extract (inclusive)."
    },
    "text_offset": {
      "type": "integer",
      "minimum": 0,
      "description": "Zero-based character offset returned by a previous call. Select exactly one item when resuming."
    }
  },
  "required": [
    "path",
    "start_page",
    "end_page"
  ],
  "additionalProperties": false
}
