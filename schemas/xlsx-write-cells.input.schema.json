{
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "description": "Absolute source XLSX path. Omit to create a new workbook."
    },
    "output_path": {
      "type": "string",
      "minLength": 1,
      "description": "Absolute path for the new output file in an existing directory. The path must be unused."
    },
    "sheet": {
      "type": "string",
      "minLength": 1,
      "maxLength": 31
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "pattern": "^[A-Za-z]{1,3}[1-9][0-9]{0,6}$",
            "description": "One A1 cell address."
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ],
            "description": "Literal value. Null clears a cell. Provide exactly one of value and formula."
          },
          "formula": {
            "type": "string",
            "pattern": "^=",
            "maxLength": 8192,
            "description": "Explicit Excel formula. Provide exactly one of formula and value."
          }
        },
        "required": [
          "address"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "sheet",
    "cells",
    "output_path"
  ],
  "additionalProperties": false
}
