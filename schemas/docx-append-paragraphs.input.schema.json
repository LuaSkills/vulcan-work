{
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "description": "Absolute source DOCX path. Omit to create a new document."
    },
    "output_path": {
      "type": "string",
      "minLength": 1,
      "description": "Absolute path for the new output file in an existing directory. The path must be unused."
    },
    "paragraphs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 10000
          },
          "heading_level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "paragraphs",
    "output_path"
  ],
  "additionalProperties": false
}
